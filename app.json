{
  "name": "heymantle-mc-webhook",
  "description": "Heymantle → Mission Control webhook bridge for real-time subscription alerts",
  "repository": "https://github.com/withlooksy/heymantle-webhook",
  "env": {
    "HEYMANTLE_WEBHOOK_SECRET": {
      "description": "Webhook secret from Heymantle dashboard",
      "required": true
    }
